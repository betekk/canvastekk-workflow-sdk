{
  "name": "@betekk/canvastekk-workflow-sdk",
  "version": "0.54.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.cjs"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "canvastekk-workflow-sdk": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ajv": "^8",
    "express": "^5.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "express": "^5.3"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "jsonwebtoken": "^9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5",
    "@types/jsonwebtoken": "^9",
    "@types/node": "^24",
    "@types/supertest": "^7",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10",
    "express": "^5.3",
    "supertest": "^7",
    "tsup": "^8",
    "typescript": "^5.8",
    "typescript-eslint": "^8",
    "vitest": "^5"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/@betekk"
  },
  "license": "Apache-2.0"
}
