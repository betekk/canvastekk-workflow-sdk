{
  "openapi": "3.2.0",
  "info": {
    "title": "Echo",
    "version": "1.2.3",
    "description": "Echoes the message"
  },
  "paths": {
    "/execute": {
      "post": {
        "summary": "Execute Echo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "message"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Execution result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Input validation failure"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "GET /health (Echo)",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/manifest": {
      "get": {
        "summary": "Manifest for Echo",
        "responses": {
          "200": {
            "description": "This node's WorkflowNodeManifest"
          }
        }
      }
    }
  }
}
